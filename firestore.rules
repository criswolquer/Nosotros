rules_version = '2';
// Cambia los dos emails por los vuestros (los mismos que en config.js)
service cloud.firestore {
  match /databases/{database}/documents {
    match /couples/{code}/{document=**} {
      allow read, write: if request.auth != null
        && code == "4AZIZhNNdznlToMOnho9sGQq"
        && request.auth.token.email in ["EMAIL_DE_CHRISTIAN", "EMAIL_DE_CELIA"];
    }
  }
}
